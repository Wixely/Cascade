{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "verify managed",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/eng/verify.ps1"],
      "problemMatcher": "$msCompile",
      "group": "test"
    },
    {
      "label": "build",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/Cascade.sln"],
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "conformance",
      "type": "process",
      "command": "dotnet",
      "args": ["run", "--project", "${workspaceFolder}/tests/Cascade.Runtime.Conformance"],
      "problemMatcher": "$msCompile",
      "group": "test"
    },
    {
      "label": "prepare sample",
      "type": "process",
      "command": "dotnet",
      "args": ["run", "--project", "${workspaceFolder}/src/Cascade.Cli", "--no-build", "--", "sample", "${workspaceFolder}/sample.cvm"],
      "dependsOn": "build",
      "dependsOrder": "sequence",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "demos",
      "type": "process",
      "command": "dotnet",
      "args": ["run", "--project", "${workspaceFolder}/examples/Cascade.Demos", "--", "all"],
      "problemMatcher": "$msCompile",
      "group": "test"
    },
    {
      "label": "compiler tests",
      "type": "process",
      "command": "dotnet",
      "args": ["run", "--project", "${workspaceFolder}/tests/Cascade.Compiler.Tests"],
      "problemMatcher": "$msCompile",
      "group": "test"
    },
    {
      "label": "compile Game of Life kernel",
      "type": "process",
      "command": "dotnet",
      "args": ["run", "--project", "${workspaceFolder}/src/Cascade.Cli", "--", "compile", "${workspaceFolder}/examples/Cascade.GameOfLife/life-rule.cascade", "-o", "${workspaceFolder}/examples/Cascade.GameOfLife/life-rule.cvm"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Game of Life demo",
      "type": "process",
      "command": "dotnet",
      "args": ["run", "--project", "${workspaceFolder}/examples/Cascade.GameOfLife"],
      "problemMatcher": "$msCompile",
      "group": "test"
    },
    {
      "label": "Game of Life benchmark",
      "type": "process",
      "command": "dotnet",
      "args": ["run", "--project", "${workspaceFolder}/examples/Cascade.GameOfLife", "-c", "Release", "--", "--benchmark"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "differential",
      "type": "process",
      "command": "dotnet",
      "args": ["run", "--project", "${workspaceFolder}/tests/Cascade.Runtime.Differential"],
      "problemMatcher": "$msCompile",
      "group": "test"
    },
    {
      "label": "benchmarks quick",
      "type": "process",
      "command": "dotnet",
      "args": ["run", "--project", "${workspaceFolder}/tools/Cascade.Benchmarks", "-c", "Release", "--", "--quick"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "verify packages",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/eng/verify-packages.ps1"],
      "problemMatcher": "$msCompile",
      "group": "test"
    },
    {
      "label": "verify Linux managed",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/eng/verify-linux.ps1"],
      "problemMatcher": "$msCompile",
      "group": "test"
    }
  ]
}
