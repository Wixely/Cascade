{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Cascade compiler: generated differential tests",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/tests/Cascade.Compiler.Tests/bin/Debug/net10.0/Cascade.Compiler.Tests.dll",
      "args": [],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Cascade benchmark: packed batches",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/tools/Cascade.Benchmarks/bin/Debug/net10.0/Cascade.Benchmarks.dll",
      "args": ["--batch", "--quick"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Cascade CLI: run sample.cvm",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "prepare sample",
      "program": "${workspaceFolder}/src/Cascade.Cli/bin/Debug/net10.0/cascade.dll",
      "args": ["run", "${workspaceFolder}/sample.cvm"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "Cascade CLI: compile Game of Life",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Cascade.Cli/bin/Debug/net10.0/cascade.dll",
      "args": ["compile", "${workspaceFolder}/examples/Cascade.GameOfLife/life-rule.cascade", "-o", "${workspaceFolder}/examples/Cascade.GameOfLife/life-rule.cvm"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "Cascade demos: all",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/examples/Cascade.Demos/bin/Debug/net10.0/Cascade.Demos.dll",
      "args": ["all"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "Cascade demo: Game of Life",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/examples/Cascade.GameOfLife/bin/Debug/net10.0/Cascade.GameOfLife.dll",
      "args": [],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    }
  ]
}
