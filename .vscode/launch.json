{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Cascade CLI: run sample.cvm",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "prepare sample",
      "program": "${workspaceFolder}/src/Cascade.Cli/bin/Debug/net10.0/cascade.dll",
      "args": ["run", "${workspaceFolder}/sample.cvm"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    }
  ]
}
