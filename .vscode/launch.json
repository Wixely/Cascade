{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Cascade CLI: run sample.cvm",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "prepare sample",
      "program": "${workspaceFolder}/src/Cascade.Cli/bin/Debug/net10.0/cascade.dll",
      "args": ["run", "${workspaceFolder}/sample.cvm"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "Cascade demos: all",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/examples/Cascade.Demos/bin/Debug/net10.0/Cascade.Demos.dll",
      "args": ["all"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "Cascade demo: Game of Life",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/examples/Cascade.GameOfLife/bin/Debug/net10.0/Cascade.GameOfLife.dll",
      "args": [],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    }
  ]
}
